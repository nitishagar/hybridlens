{
  "name": "hybridlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrivRedact — document PII redaction with Firebase AI Logic hybrid inference. #BuildHybridAI 2026 entry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude **/*.live.test.ts",
    "test:live": "vitest run tests/live --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "bash scripts/verify.sh",
    "smoke": "node scripts/smoke.mjs",
    "sanitize-har": "node scripts/sanitize-har.mjs",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.14.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
