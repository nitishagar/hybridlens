# Copy to .env and fill from the Firebase console (AI Logic → Gemini Developer API).
# Never commit .env. App Check debug token stays in the console + local only.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# App Check (D2): reCAPTCHA Enterprise site key (required everywhere — the
# debug flow still needs a provider). Debug token is localhost-dev only and
# optional: when empty, the SDK prints a token to register in the console.
VITE_APPCHECK_SITE_KEY=YOUR_SITE_KEY
VITE_APPCHECK_DEBUG_TOKEN=
